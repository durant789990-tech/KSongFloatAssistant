package com.zzy.ksongfloat.config;
import android.content.Context;
public class TargetAppConfig { public static final String DEFAULT_PACKAGE="com.tencent.karaoke"; public static String getTargetPackage(Context c){ return c.getSharedPreferences("target_app",Context.MODE_PRIVATE).getString("package",DEFAULT_PACKAGE); } public static void saveTargetPackage(Context c,String p){ if(p!=null&&!p.trim().isEmpty()) c.getSharedPreferences("target_app",Context.MODE_PRIVATE).edit().putString("package",p.trim()).apply(); } public static boolean matches(Context c,String pkg){ String t=getTargetPackage(c); return pkg!=null&&(pkg.equals(t)||pkg.contains("karaoke")); } }
